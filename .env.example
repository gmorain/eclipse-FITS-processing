# Copier en .env, qui n'est pas suivi par git.
# L'environnement du processus prime sur ce fichier.

# Dossier des captures FITS de la session. Obligatoire, chemin absolu.
ECLIPSE_SESSION_DIR="/chemin/vers/la/session/01 - Captures ASI Air/LIGHT/SUN"

# Facultatif. Captures d'annotation embarquees dans le rapport HTML.
# Par defaut "05 - Annotations", trois niveaux au-dessus des captures.
#ECLIPSE_ANNOTATIONS_DIR=

# Facultatif. Sorties du traitement. Par defaut out/ a la racine du depot.
#ECLIPSE_OUT_DIR=
